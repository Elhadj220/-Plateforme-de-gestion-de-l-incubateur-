# Copier ce fichier en .env puis renseigner les valeurs.

# Environnement : development ou production
NODE_ENV=development
PORT=3000

# Secret de signature des sessions (OBLIGATOIRE en production, 32 caractères minimum).
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Clé API Google Gemini (gratuite sur https://aistudio.google.com/apikey).
# Sans clé, l'application fonctionne avec un modèle de secours (brouillons structurés non génératifs).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modèles essayés si le principal est surchargé ou indisponible (séparés par des virgules)
GEMINI_MODELES_REMPLACEMENT=gemini-3.8-flash,gemini-flash-latest

# Emplacements des données (facultatif)
# DB_PATH=data/incubateur.db
# UPLOAD_DIR=data/uploads
