<%- include('../partials/haut') %>
<div class="auth">
  <div class="carte">
    <div class="centre"><img src="/static/img/logo-symbole.svg" alt="" width="56" height="56"></div>
    <h1 class="centre" style="margin-top:12px">Connexion</h1>
    <p class="centre muted">Accédez à votre espace Incub'ISEP.</p>
    <%- include('../partials/flash') %>
    <% if (typeof erreur !== 'undefined' && erreur) { %><div class="flash erreur" role="alert"><%= erreur %></div><% } %>
    <form method="post" action="/connexion" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="champ">
        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" autocomplete="username" required value="<%= email %>">
      </div>
      <div class="champ">
        <label for="mot_de_passe">Mot de passe</label>
        <input id="mot_de_passe" name="mot_de_passe" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn bloc" type="submit">Se connecter</button>
    </form>
    <p class="centre petit" style="margin-top:16px">Porteur de projet sans compte ? <a href="/inscription">Créer un compte</a></p>
    <details class="comptes-demo encart">
      <summary><strong>Comptes de démonstration</strong> (mot de passe : <code>Demo2026!</code>)</summary>
      <ul style="margin:8px 0 0;padding-left:18px">
        <li>Coordonnatrice : <code>coordination@demo.sn</code></li>
        <li>Membre du comité : <code>comite@demo.sn</code></li>
        <li>Mentor : <code>mentor@demo.sn</code></li>
        <li>Porteuse (projet incubé) : <code>porteur@demo.sn</code></li>
        <li>Porteur (dossier en brouillon) : <code>porteur2@demo.sn</code></li>
      </ul>
    </details>
  </div>
</div>
<%- include('../partials/bas') %>
